# Copy to .env and adjust. .env is git-ignored: never commit real values.
# The values below are for LOCAL DEVELOPMENT ONLY.

# Public origin of the site, no trailing slash.
#   dev:  http://localhost:8090  (port must match HTTP_PORT)
#   prod: https://candle.vyachdiliger.com
PUBLIC_URL=http://localhost:8090

# Host port of Candle's entry point (container `proxy`). Bound to 127.0.0.1;
# in production the server's Caddy proxies the domain to it.
HTTP_PORT=8090

POSTGRES_PASSWORD=candle-dev
STORAGE_ACCESS_KEY=candle-local
STORAGE_SECRET_KEY=candle-local-secret

# At least 32 characters. Production: `openssl rand -base64 48`.
# Outside Development the API refuses to start with a placeholder key.
JWT_KEY=local-development-only-jwt-signing-key-not-for-production

# Telegram bot is off by default. For bot work create your own test bot with
# @BotFather - never use the production bot locally.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Letters, digits, "_" and "-" only. Production: `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# Production only: where `make deploy` pulls images from (built by GitHub Actions).
IMAGE_REGISTRY=ghcr.io/chandrey06
IMAGE_TAG=latest

# Development only: host ports for running the API from an IDE.
DEV_DB_PORT=5433
DEV_STORAGE_PORT=8333
