# Candle's internal router (container `proxy`, plain HTTP on :80).
# TLS and the public domain are handled in front of it, see docs/deployment.md.
:80 {
	encode zstd gzip

	# /candles/{id} is rendered by the API (link previews); `handle` keeps the path intact.
	@backend path /api /api/* /candles/*
	handle @backend {
		reverse_proxy api:8080
	}

	# Media storage (SeaweedFS S3) is reachable from outside only for presigned
	# uploads to the staging prefix. Everything else (GET, listing, DELETE,
	# writes to published resources/*) is closed, so even leaked storage keys
	# cannot read or change user media through the public URL. Images are served
	# by the API under /api.
	handle /candle-media/* {
		@upload {
			method PUT OPTIONS
			path /candle-media/uploads/*
		}
		handle @upload {
			reverse_proxy storage:8333
		}
		handle {
			respond 404
		}
	}

	handle {
		reverse_proxy web:80
	}
}
